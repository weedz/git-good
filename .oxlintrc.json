{
  "plugins": [
    "typescript",
    "oxc",
    "unicorn",
    "import",
    "promise",
    //"react"
  ],
  "rules": {
    "no-unused-vars": [
      "error",
      {
        "varsIgnorePattern": "^_",
        "argsIgnorePattern": "^_",
        "caughtErrorsIgnorePattern": "^_"
      }
    ]
  }
}
