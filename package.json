{
  "name": "git-good",
  "version": "0.1.5",
  "description": "Git good",
  "main": "dist/main.js",
  "type": "module",
  "scripts": {
    "start": "electron --ozone-platform-hint=wayland .",
    "lint": "oxlint -c .oxlintrc.json --tsconfig ./tsconfig.json -D correctness -D perf --import-plugin -D no-cycle --promise-plugin",
    "tsc:watch": "tsc --noEmit --watch",
    "dev": "NODE_ENV=development pnpm run build",
    "build": "rm -rf dist;mkdir dist;cp static/* dist/; node scripts/build.mjs",
    "dist": "electron-builder",
    "electron-rebuild": "JOBS=max CC=clang CXX=clang++ LINK=clang++ electron-rebuild"
  },
  "keywords": [],
  "author": {
    "name": "Linus Björklund",
    "email": "weedzcokie@gmail.com"
  },
  "files": [
    "dist"
  ],
  "license": "GPL-3.0-or-later",
  "devDependencies": {
    "@electron/asar": "^3.3.1",
    "@electron/rebuild": "^3.7.1",
    "@types/node": "^22.13.14",
    "@types/nodegit": "^0.28.7",
    "@weedzcokie/store": "^2.0.2",
    "electron": "~35.1.2",
    "esbuild": "^0.25.1",
    "oxlint": "^0.16.3",
    "preact": "^10.26.4",
    "typescript": "^5.8.2"
  },
  "resolutions": {
    "make-fetch-happen": "^13",
    "@electron/get": "^3"
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": [
        "webpack",
        "electron-builder-squirrel-windows"
      ]
    },
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ]
  },
  "build": {
    "appId": "git-good",
    "afterPack": "./scripts/after-pack.cjs",
    "directories": {
      "output": "out"
    },
    "linux": {
      "category": "Development",
      "target": [
        "AppImage",
        "deb"
      ]
    },
    "mac": {
      "category": "public.app-category.developer-tools"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/weedz/git-good.git"
  },
  "bugs": {
    "url": "https://github.com/weedz/git-good/issues"
  },
  "homepage": "https://github.com/weedz/git-good#readme",
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "dependencies": {
    "nodegit": "github:weedz/nodegit#master"
  },
  "packageManager": "pnpm@10.7.0+sha512.6b865ad4b62a1d9842b61d674a393903b871d9244954f652b8842c2b553c72176b278f64c463e52d40fff8aba385c235c8c9ecf5cc7de4fd78b8bb6d49633ab6"
}
