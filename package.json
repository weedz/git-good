{
  "name": "git-good",
  "version": "0.1.5",
  "description": "Git good",
  "main": "dist/main.js",
  "type": "module",
  "scripts": {
    "start": "electron --ozone-platform-hint=wayland .",
    "lint": "oxlint -c .oxlintrc.json --tsconfig ./tsconfig.json -D correctness -D perf --import-plugin -D no-cycle --promise-plugin",
    "tsc:watch": "tsc --noEmit --watch",
    "dev": "NODE_ENV=development npm run build",
    "build": "rm -rf dist;mkdir dist;cp static/* dist/; node scripts/build.mjs",
    "dist": "electron-builder",
    "electron-rebuild": "JOBS=max CC=clang CXX=clang++ LINK=clang++ electron-rebuild"
  },
  "keywords": [],
  "author": {
    "name": "Linus Björklund",
    "email": "weedzcokie@gmail.com"
  },
  "files": [
    "dist"
  ],
  "license": "GPL-3.0-or-later",
  "devDependencies": {
    "@electron/asar": "^3.3.1",
    "@electron/rebuild": "^3.7.1",
    "@types/node": "^22.13.9",
    "@types/nodegit": "^0.28.7",
    "@weedzcokie/store": "^2.0.2",
    "electron": "~34.3.1",
    "esbuild": "^0.25.0",
    "oxlint": "^0.15.13",
    "preact": "^10.26.4",
    "typescript": "^5.8.2"
  },
  "resolutions": {
    "make-fetch-happen": "^13",
    "@electron/get": "^3"
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": [
        "webpack",
        "electron-builder-squirrel-windows"
      ]
    }
  },
  "build": {
    "appId": "git-good",
    "afterPack": "./scripts/after-pack.cjs",
    "directories": {
      "output": "out"
    },
    "linux": {
      "category": "Development",
      "target": [
        "AppImage",
        "deb"
      ]
    },
    "mac": {
      "category": "public.app-category.developer-tools"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/weedz/git-good.git"
  },
  "bugs": {
    "url": "https://github.com/weedz/git-good/issues"
  },
  "homepage": "https://github.com/weedz/git-good#readme",
  "engines": {
    "node": ">=16",
    "pnpm": ">=7"
  },
  "dependencies": {
    "nodegit": "github:weedz/nodegit#master"
  },
  "packageManager": "pnpm@9.15.4+sha512.b2dc20e2fc72b3e18848459b37359a32064663e5627a51e4c74b2c29dd8e8e0491483c3abb40789cfd578bf362fb6ba8261b05f0387d76792ed6e23ea3b1b6a0"
}
