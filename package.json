{
  "name": "git-good",
  "version": "0.1.5",
  "description": "Git good",
  "main": "dist/main.js",
  "type": "module",
  "scripts": {
    "start": "electron --ozone-platform-hint=wayland .",
    "lint": "oxlint -c .oxlintrc.json --tsconfig ./tsconfig.json -D correctness -D perf -D no-cycle",
    "tsc:watch": "tsc --noEmit --watch --preserveWatchOutput",
    "dev": "NODE_ENV=development pnpm run build",
    "build": "rm -rf dist;mkdir dist;cp static/* dist/; node scripts/build.mjs",
    "build:native": "./scripts/build-native.sh"
  },
  "keywords": [],
  "author": {
    "name": "Linus Björklund",
    "email": "weedzcokie@gmail.com"
  },
  "files": [
    "dist"
  ],
  "license": "GPL-3.0-or-later",
  "devDependencies": {
    "@types/node": "^22.17.1",
    "@types/nodegit": "^0.28.8",
    "@weedzcokie/store": "^2.0.3",
    "electron": "~36.7.4",
    "esbuild": "^0.25.8",
    "oxlint": "^1.11.0",
    "preact": "^10.27.0",
    "typescript": "^5.9.2"
  },
  "resolutions": {
    "@electron/get": "^4",
    "node-abi": "^4"
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": [
        "webpack",
        "electron-builder-squirrel-windows"
      ]
    },
    "onlyBuiltDependencies": [
      "electron",
      "esbuild",
      "nodegit"
    ]
  },
  "build": {
    "appId": "git-good",
    "afterPack": "./scripts/after-pack.cjs",
    "directories": {
      "output": "out"
    },
    "linux": {
      "category": "Development",
      "target": [
        "AppImage",
        "deb"
      ]
    },
    "mac": {
      "category": "public.app-category.developer-tools"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/weedz/git-good.git"
  },
  "bugs": {
    "url": "https://github.com/weedz/git-good/issues"
  },
  "homepage": "https://github.com/weedz/git-good#readme",
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "dependencies": {
    "nodegit": "github:weedz/nodegit#master"
  },
  "packageManager": "pnpm@10.14.0+sha512.ad27a79641b49c3e481a16a805baa71817a04bbe06a38d17e60e2eaee83f6a146c6a688125f5792e48dd5ba30e7da52a5cda4c3992b9ccf333f9ce223af84748"
}
