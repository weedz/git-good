{
  "name": "git-good",
  "version": "0.1.5",
  "description": "Git good",
  "main": "dist/main.js",
  "type": "module",
  "scripts": {
    "start": "electron --ozone-platform-hint=wayland .",
    "lint": "oxlint -c .oxlintrc.json --tsconfig ./tsconfig.json -D correctness -D perf --import-plugin -D no-cycle --promise-plugin",
    "tsc:watch": "tsc --noEmit --watch --preserveWatchOutput",
    "dev": "NODE_ENV=development pnpm run build",
    "build": "rm -rf dist;mkdir dist;cp static/* dist/; node scripts/build.mjs",
    "build:native": "./scripts/build-native.sh"
  },
  "keywords": [],
  "author": {
    "name": "Linus Björklund",
    "email": "weedzcokie@gmail.com"
  },
  "files": [
    "dist"
  ],
  "license": "GPL-3.0-or-later",
  "devDependencies": {
    "@types/node": "^22.15.21",
    "@types/nodegit": "^0.28.8",
    "@weedzcokie/store": "^2.0.3",
    "electron": "~36.3.1",
    "esbuild": "^0.25.4",
    "oxlint": "^0.16.11",
    "preact": "^10.26.6",
    "typescript": "^5.8.3"
  },
  "resolutions": {
    "@electron/get": "^3",
    "node-abi": "^4"
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": [
        "webpack",
        "electron-builder-squirrel-windows"
      ]
    },
    "onlyBuiltDependencies": [
      "electron",
      "esbuild",
      "nodegit"
    ]
  },
  "build": {
    "appId": "git-good",
    "afterPack": "./scripts/after-pack.cjs",
    "directories": {
      "output": "out"
    },
    "linux": {
      "category": "Development",
      "target": [
        "AppImage",
        "deb"
      ]
    },
    "mac": {
      "category": "public.app-category.developer-tools"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/weedz/git-good.git"
  },
  "bugs": {
    "url": "https://github.com/weedz/git-good/issues"
  },
  "homepage": "https://github.com/weedz/git-good#readme",
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "dependencies": {
    "nodegit": "github:weedz/nodegit#master"
  },
  "packageManager": "pnpm@10.11.0+sha512.6540583f41cc5f628eb3d9773ecee802f4f9ef9923cc45b69890fb47991d4b092964694ec3a4f738a420c918a333062c8b925d312f42e4f0c263eb603551f977"
}
